# Supabase (frontend). Everything prefixed VITE_ is bundled into the public
# JavaScript build — only ever put publishable/anon values here.
# Never add a service_role key or an OpenAI key to this file.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
